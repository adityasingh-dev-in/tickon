generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  TASK_ASSIGNED
  COMMENT_ADDED
  MEMBER_ADDED
  MEMBER_ROLE_CHANGED
}

enum ActivityEntityType {
  PROJECT
  MEMBER
  COLUMN
  TASK
  LABEL
  COMMENT
  FILE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdProjects Project[]
  createdClients  Client[]
  memberships     ProjectMember[]
  assignedTasks   Task[]
  comments        Comment[]
  fileAssets      FileAsset[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
  refreshTokens   RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  familyId  String    // one family per login (device/session); rotation keeps the same familyId
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  rotatedAt DateTime? // set when this token was replaced by a newer one in the same family
  revokedAt DateTime? // set when revoked (rotation, logout, or family revocation)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model Client {
  id          String   @id @default(cuid())
  name        String
  email       String?
  company     String?
  phone       String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  projects    Project[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
}

model Project {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  taskCounter Int      @default(0)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members      ProjectMember[]
  columns      KanbanColumn[]
  tasks        Task[]
  labels       Label[]
  activityLogs ActivityLog[]

  @@index([clientId])
  @@index([createdById])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model KanbanColumn {
  id        String   @id @default(cuid())
  title     String
  position  Int
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())

  @@index([projectId, position])
}

model Task {
  id          String       @id @default(cuid())
  taskNumber  Int
  taskKey     String       @unique
  title       String
  description String?
  priority    Priority     @default(MEDIUM)
  position    Float
  dueDate     DateTime?
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columnId    String
  column      KanbanColumn @relation(fields: [columnId], references: [id], onDelete: NoAction)
  assigneeId  String?
  assignee    User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  labels      Label[]
  comments    Comment[]
  files       FileAsset[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([projectId, taskNumber])
  @@index([projectId])
  @@index([columnId, position])
  @@index([assigneeId])
}

model Label {
  id        String   @id @default(cuid())
  name      String
  color     String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())

  @@unique([projectId, name])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
}

model FileAsset {
  id           String   @id @default(cuid())
  publicId     String   @unique
  secureUrl    String
  fileName     String
  fileSize     Int
  fileType     String   // MIME type
  resourceType String   // Cloudinary resource_type: image | raw | video (needed to delete the asset)
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([taskId])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  message     String
  linkUrl     String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([recipientId, isRead, createdAt])
}

model ActivityLog {
  id         String             @id @default(cuid())
  actorId    String?
  actor      User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)
  projectId  String
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entityType ActivityEntityType
  entityId   String?            // no FK on purpose: history must survive deleted entities
  action     String             // e.g. "task.created", "task.moved"
  details    Json?
  createdAt  DateTime           @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, entityType, entityId])
}

